# =============================================================================
# MundoLimpio — Environment Configuration
# =============================================================================
# WHAT: Variables de entorno para desarrollo local.
# WHY: Centralizar configuraciones que cambian entre entornos (dev, staging, prod)
#      sin hardcodear URLs ni keys en el código fuente.
# BENEFITS: Seguridad (no se commitean secrets), flexibilidad (cambiar backend
#           sin recompilar), onboarding rápido (clonar, copiar .env, listo).
#
# USO:
#   1. Copiá este archivo a .env:  cp .env.example .env
#   2. Editá .env con tus valores locales
#   3. NUNCA commitees .env (está en .gitignore)
#
# Variables disponibles en la app vía react-native-config (o manualmente
# desde appConfig.ts usando process.env en Metro):
# =============================================================================

# Backend API — Spring Boot 3.3
# Desarrollo local (Android emulator): http://10.0.2.2:8080
# Desarrollo local (iOS simulator):   http://localhost:8080
# Staging:                             https://api-staging.mundolimpio.com
# Producción:                          https://api.mundolimpio.com
BASE_URL=http://localhost:8080

# Timeout HTTP en milisegundos (45s para cubrir cold starts de Render)
HTTP_TIMEOUT=45000

# Tamaño de página por defecto para endpoints paginados
PAGE_SIZE=20
